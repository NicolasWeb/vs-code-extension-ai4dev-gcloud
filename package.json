{
  "name": "ai4dev-monitor",
  "displayName": "AI4Dev Monitor",
  "description": "Monitor and control the ai4dev tunnel from VS Code.",
  "version": "0.2.0",
  "publisher": "nitronicolasoft",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:ai4devMonitor.showActions",
    "onCommand:ai4devMonitor.migrateSettings"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ai4devMonitor.showActions",
        "title": "AI4Dev Monitor",
        "category": "AI4Dev"
      },
      {
        "command": "ai4devMonitor.migrateSettings",
        "title": "Migrate legacy settings",
        "category": "AI4Dev Monitor"
      }
    ],
    "configuration": {
      "title": "AI4Dev Monitor",
      "properties": {
        "ai4devMonitor.installPath": {
          "type": "string",
          "default": "~/agents/ai4dev"
        },
        "ai4devMonitor.authenticationPromptPrefill": {
          "type": "boolean",
          "default": true,
          "description": "Whether to enable authentication-renewal command prefill in the next interactive shell prompt."
        },
        "ai4devMonitor.wslDistro": {
          "type": "string",
          "default": ""
        },
        "ai4devMonitor.refreshIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1
        },
        "ai4devMonitor.commandTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 1
        },
        "ai4devMonitor.logLines": {
          "type": "number",
          "default": 50,
          "minimum": 1
        }
      }
    }
  },
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/NicolasWeb/ai-agents-md.git",
    "directory": "vs-code-extensions/home-made/ai4dev-monitor"
  },
  "bugs": {
    "url": "https://github.com/NicolasWeb/ai-agents-md/issues"
  },
  "homepage": "https://github.com/NicolasWeb/ai-agents-md/tree/main/vs-code-extensions/home-made/ai4dev-monitor",
  "keywords": [
    "ai4dev",
    "tunnel",
    "vscode",
    "wsl",
    "status-bar",
    "remote-development"
  ]
}
